# Lyapunov/Peiri 服务端环境模板；真实值只放密钥管理器或包外 .env。
LYAPUNOV_API_DATABASE=/var/lib/lyapunov/lyapunov-api.sqlite
# 模型目录（Peiri 上游映射）**二选一**，给一个就够（两个都给时以非空的 _JSON 为准）：
#   _JSON 直接给 JSON 文本（密钥管理器／容器注入用，形状见 `services/lyapunov-api/config/model-catalog.example.json`），
#   _FILE 给服务器上那份 JSON 的路径。两个都没有 ⇒ 启动即报
#   "LYAPUNOV_MODEL_CATALOG_JSON or LYAPUNOV_MODEL_CATALOG_FILE is required"（不猜、不回落）。
LYAPUNOV_MODEL_CATALOG_FILE=/etc/lyapunov/model-catalog.json
# LYAPUNOV_MODEL_CATALOG_JSON=[{"publicId":"peiri","selectable":true,…}]
LYAPUNOV_API_HOST=0.0.0.0
LYAPUNOV_API_PORT=8787
LYAPUNOV_PUBLIC_ORIGIN=https://api.vorynel.com
# ALLOWED_ORIGINS 只放浏览器跨源客户端的 origin（按真实客户端用途），不是 API 自己的入口域名：
# publicOrigin 已由 loadConfig 自动加进允许集，这里再写一遍等于什么都不放行。
# 域名口径以 LyapunovOM 的部署说明为准；与服务端 .env.example 保持同一份说明。
LYAPUNOV_ALLOWED_ORIGINS=https://vorynel.com
LYAPUNOV_SESSION_PEPPER=CHANGE_ME_generate_at_least_32_random_characters
LYAPUNOV_PAYMENT_WEBHOOK_SECRET=CHANGE_ME_generate_at_least_32_random_characters

# 官网身份权威仍是 vorynel.com；新服务（华北）入口为 api.vorynel.com，浏览器回调同域。
# 旧占位域名 vorynel.tech 已退役（DNS 不解析，2026-09-22 实测），任何配置不得再引用。
# 域名以 deployment/README.md 为准。
# 回调地址必须与官网身份服务登记的回调一致：https://api.vorynel.com/v1/auth/website/callback
LYAPUNOV_IDENTITY_BASE_URL=https://vorynel.com
LYAPUNOV_IDENTITY_CLIENT_ID=lyaup-desktop
LYAPUNOV_IDENTITY_CLIENT_SECRET=CHANGE_ME_generate_at_least_32_random_characters
LYAPUNOV_IDENTITY_REDIRECT_URI=https://api.vorynel.com/v1/auth/website/callback

# 与官网共用同一个中央积分账本。
LYAPUNOV_BILLING_SERVICE_URL=https://vorynel.com/billing
LYAPUNOV_BILLING_PUBLIC_URL=https://vorynel.com/billing
LYAPUNOV_BILLING_APP_ID=official-web
LYAPUNOV_BILLING_APP_SECRET=CHANGE_ME_generate_at_least_32_random_characters

# 以下三项可选（config.ts:227-230）：不给就是没有管理员入口、也没有支付跳转按钮；
# 给了 admin secret 才开管理员入口，支付链接模板必须含 {orderId}，非 localhost 必须 HTTPS。
# LYAPUNOV_ADMIN_SECRET=CHANGE_ME
# LYAPUNOV_ALIPAY_CHECKOUT_URL_TEMPLATE=https://pay.example.invalid/alipay?orderId={orderId}&amountFen={amountFen}
# LYAPUNOV_WECHAT_CHECKOUT_URL_TEMPLATE=https://pay.example.invalid/wechat?orderId={orderId}&amountFen={amountFen}

# 对外唯一模型是 Peiri；上游和密钥只在服务器端配置。
LYAPUNOV_RELAY_PEIRI_BASE_URL=https://api.example.invalid/v1
LYAPUNOV_RELAY_PEIRI_MODEL=deepseek-flash
LYAPUNOV_RELAY_PEIRI_API_KEY=CHANGE_ME
LYAPUNOV_PEIRI_SYSTEM_PROMPT=你是 Peiri，是 Vorynel 公司开发的控制模型。你负责理解用户的自然语言目标，并通过 Lyapunov 的工具、场景和机器人能力完成任务。

# 生成 provider 只作为服务端预留，不向客户端暴露 provider 选择。
# ⚠️ 本段（含下面 Tripo／图像两组）的口径对着 **LyapunovOM 权威检出** 核过：
#   `backend/dev-server/services/lyapunov-api/src/config.ts` 对 MARBLE / HUNYUAN / TRIPO / IMAGE **四段都真读**。
#   工作区里 LyapunovIssue / LyapunovDev / LyapunovLinux 等检出把同一服务平铺在 `<root>/services/lyapunov-api`，
#   那些检出**没有 Tripo／图像接线**（2026-09-27 实测：对 `LYAPUNOV_TRIPO_*` / `LYAPUNOV_IMAGE_*` 各 0 读取点），
#   别拿它们判本段注释 —— 它们不是 LyapunovOM。
# LYAPUNOV_MARBLE_API_BASE_URL=https://api.example.invalid
# LYAPUNOV_MARBLE_API_KEY=CHANGE_ME
# LYAPUNOV_MARBLE_POINTS=2000
# LYAPUNOV_HUNYUAN_API_BASE_URL=https://api.example.invalid
# LYAPUNOV_HUNYUAN_API_KEY=CHANGE_ME
# LYAPUNOV_HUNYUAN_POINTS=1000
# Tripo 3D（阿里云百炼）：三键同配（缺一启动即报错）；POINTS 是每请求固定积分，必须显式给出、无默认值。
# LYAPUNOV_TRIPO_API_BASE_URL=https://dashscope.aliyuncs.com
# LYAPUNOV_TRIPO_API_KEY=CHANGE_ME
# LYAPUNOV_TRIPO_POINTS=700
# 图像（百炼千问图像）四件套必须同时给出，半配置在启动时直接报错；points 是每请求固定积分。
# LYAPUNOV_IMAGE_API_BASE_URL=https://dashscope.aliyuncs.com
# LYAPUNOV_IMAGE_API_KEY=CHANGE_ME
# LYAPUNOV_IMAGE_MODEL=qwen-image-3.0
# LYAPUNOV_IMAGE_SUBMIT_PATH=/api/v1/services/aigc/image-generation/generation
# LYAPUNOV_IMAGE_POINTS=300
