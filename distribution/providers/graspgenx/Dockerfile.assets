# syntax=docker/dockerfile:1.7
# LyapunovDSH: 独立资产初始化器；所有Hub操作固定镜像，不回退官方端点。

ARG PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
FROM ${PYTHON_IMAGE}

ARG HF_CLI_VERSION=1.29.0

LABEL org.opencontainers.image.title="Lyapunov GraspGenX asset initializer" \
      org.opencontainers.image.description="Downloads hash-locked GraspGenX model and Panda assets into Docker named volumes" \
      org.opencontainers.image.source="https://hf-mirror.com/adithyamurali/GraspGenXModel" \
      org.opencontainers.image.revision="7c834043c11a11417e31d6d5ea9355801e40a2c1"

ENV HF_ENDPOINT=https://hf-mirror.com \
    HF_HUB_DISABLE_XET=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/tmp/huggingface \
    HF_HUB_DISABLE_IMPLICIT_TOKEN=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    HF_XET_CHUNK_CACHE_SIZE_BYTES=0 \
    HF_XET_RECONSTRUCT_WRITE_SEQUENTIALLY=1

RUN python -m pip install --no-cache-dir "huggingface-hub[hf-xet]==${HF_CLI_VERSION}"

COPY download-assets.py /usr/local/bin/download-graspgenx-assets
RUN chmod 0555 /usr/local/bin/download-graspgenx-assets

ENTRYPOINT ["python", "/usr/local/bin/download-graspgenx-assets"]
