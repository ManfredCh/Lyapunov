diff --git a/packages/api/session-controller/src/outbound-projection.ts b/packages/api/session-controller/src/outbound-projection.ts
new file mode 100644
index 0000000000..eb062fd93d
--- /dev/null
+++ b/packages/api/session-controller/src/outbound-projection.ts
@@ -0,0 +1,119 @@
+/** Required consumer projection for Session history leaving the Host for a browser. */
+
+import type { Context } from '@deepseek-ai/cordis'
+import type { AssistantStreamRecord, ContentBlock, StreamChunk } from '@deepseek-ai/dsh-llm'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+
+/** Service name a Host plugin provides to own browser wire projection. */
+export const SESSION_OUTBOUND_PROJECTION = 'sessionOutboundProjection'
+
+/**
+ * Pure synchronous projection of detached browser copies. Event projectors own
+ * data, not type/seq/time/sourceEventSeqs/surfaceOp/ignorable. Block projectors
+ * receive content blocks; tool argument fragments may be incomplete JSON.
+ */
+export interface SessionOutboundProjectionService {
+  projectEvent(event: unknown): unknown
+  projectBlock(block: unknown): unknown
+}
+
+/** Late-bound outbound operations; absent or malformed providers fail closed. */
+export interface SessionOutboundProjectors {
+  event(event: SessionEvent): SessionEvent
+  block(chunk: StreamChunk): StreamChunk
+  stream(records: readonly AssistantStreamRecord[]): readonly AssistantStreamRecord[]
+}
+
+/**
+ * Resolve the active provider on each outbound operation, including after
+ * provider load, disposal, or replacement. Missing/malformed providers and
+ * provider errors reject the operation rather than exposing unprojected data.
+ * @param ctx - Host context that may carry the consumer projection service.
+ * @returns projectors for detached events, live chunks, and compact streams.
+ */
+export function sessionOutboundProjection(ctx: Context): SessionOutboundProjectors {
+  const resolve = (): SessionOutboundProjectionService => {
+    const service = ctx.get(SESSION_OUTBOUND_PROJECTION) as SessionOutboundProjectionService | undefined
+    if (service == null
+      || typeof service.projectEvent !== 'function'
+      || typeof service.projectBlock !== 'function') {
+      throw new Error(`missing active ${SESSION_OUTBOUND_PROJECTION} service`)
+    }
+    return service
+  }
+  return {
+    event(event) {
+      const service = resolve()
+      const projected = service.projectEvent(structuredClone(event)) as SessionEvent
+      const data = event.type === 'assistant/message' || event.type === 'assistant/attempt'
+        ? { ...projected.data, stream: projectStream(event.data.stream, service) }
+        : projected.data
+      // Consumers may only replace data; native ordering and surface metadata stay intact.
+      return { ...event, data } as SessionEvent
+    },
+    block(chunk) {
+      return projectChunk(structuredClone(chunk), resolve())
+    },
+    stream(records) {
+      return projectStream(records, resolve())
+    },
+  }
+}
+
+function projectChunk(chunk: StreamChunk, service: SessionOutboundProjectionService): StreamChunk {
+  switch (chunk.type) {
+    case 'block-end':
+      return { ...chunk, block: service.projectBlock(chunk.block) as ContentBlock }
+    case 'tool-call-delta': {
+      const block = service.projectBlock({
+        type: 'tool-call', id: chunk.id, name: chunk.name ?? '', arguments: chunk.argumentsDelta,
+      }) as Extract<ContentBlock, { type: 'tool-call' }>
+      return { ...chunk, argumentsDelta: block.arguments }
+    }
+    case 'text-delta':
+    case 'reasoning-delta': {
+      const block = service.projectBlock({
+        type: chunk.type === 'text-delta' ? 'text' : 'reasoning', text: chunk.text,
+      }) as Extract<ContentBlock, { type: 'text' | 'reasoning' }>
+      return { ...chunk, text: block.text }
+    }
+    default:
+      return chunk
+  }
+}
+
+function projectStream(
+  records: readonly AssistantStreamRecord[],
+  service: SessionOutboundProjectionService,
+): AssistantStreamRecord[] {
+  return records.map((source) => {
+    const record = structuredClone(source)
+    switch (record.type) {
+      case 'chunk':
+        return { ...record, chunk: projectChunk(record.chunk, service) }
+      case 'tool-call-chunks':
+        return {
+          ...record,
+          args: record.args.map(argumentsDelta => {
+            const chunk = projectChunk({
+              type: 'tool-call-delta', index: record.index, id: record.id,
+              ...record.name === undefined ? {} : { name: record.name }, argumentsDelta,
+            }, service) as Extract<StreamChunk, { type: 'tool-call-delta' }>
+            return chunk.argumentsDelta
+          }),
+        }
+      case 'text-chunks':
+      case 'reasoning-chunks':
+        return {
+          ...record,
+          texts: record.texts.map(text => {
+            const chunk = projectChunk({
+              type: record.type === 'text-chunks' ? 'text-delta' : 'reasoning-delta',
+              index: record.index, text,
+            }, service) as Extract<StreamChunk, { type: 'text-delta' | 'reasoning-delta' }>
+            return chunk.text
+          }),
+        }
+    }
+  })
+}
