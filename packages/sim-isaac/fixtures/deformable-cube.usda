#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    def TetMesh "Body" (
        prepend apiSchemas = ["OmniPhysicsDeformableBodyAPI", "OmniPhysicsVolumeDeformableSimAPI", "PhysicsCollisionAPI", "PhysxBaseDeformableBodyAPI", "MaterialBindingAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding:physics = </Asset/Materials/Elastic> (
            bindMaterialAs = "weakerThanDescendants"
        )
        point3f[] omniphysics:restShapePoints = [(0, 0, 0), (0.24, 0, 0), (0.24, 0.24, 0), (0, 0.24, 0), (0, 0, 0.24), (0.24, 0, 0.24), (0.24, 0.24, 0.24), (0, 0.24, 0.24)]
        int4[] omniphysics:restTetVtxIndices = [(0, 1, 3, 4), (1, 2, 3, 6), (1, 4, 5, 6), (3, 4, 6, 7), (1, 3, 4, 6)]
        float physxCollision:contactOffset = 0.005
        float physxCollision:restOffset = 0.001
        uint physxDeformableBody:solverPositionIterationCount = 16
        point3f[] points = [(0, 0, 0), (0.24, 0, 0), (0.24, 0.24, 0), (0, 0.24, 0), (0, 0, 0.24), (0.24, 0, 0.24), (0.24, 0.24, 0.24), (0, 0.24, 0.24)]
        int3[] surfaceFaceVertexIndices = [(0, 1, 4), (0, 3, 1), (0, 4, 3), (1, 2, 6), (1, 3, 2), (1, 5, 4), (1, 6, 5), (2, 3, 6), (3, 4, 7), (3, 7, 6), (4, 5, 6), (4, 6, 7)]
        int4[] tetVertexIndices = [(0, 1, 3, 4), (1, 2, 3, 6), (1, 4, 5, 6), (3, 4, 6, 7), (1, 3, 4, 6)]
    }

    def "Materials"
    {
        def Material "Elastic" (
            prepend apiSchemas = ["OmniPhysicsDeformableMaterialAPI"]
        )
        {
            float omniphysics:density = 1000
            float omniphysics:dynamicFriction = 0.5
            float omniphysics:poissonsRatio = 0.35
            float omniphysics:staticFriction = 0.5
            float omniphysics:youngsModulus = 20000
        }
    }
}

