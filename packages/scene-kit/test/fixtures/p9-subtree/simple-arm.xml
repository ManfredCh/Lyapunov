<mujoco model="simple-arm">
  <option integrator="implicitfast"/>
  <worldbody>
    <body name="base">
      <geom type="box" size="0.05 0.05 0.05"/>
      <body name="arm" pos="0 0 0.1">
        <joint name="j1" type="hinge" axis="0 0 1" range="-1.5 1.5"/>
        <geom type="capsule" size="0.02 0.1"/>
        <body name="hand" pos="0 0 0.2">
          <joint name="j2" type="hinge" axis="0 1 0" range="-1 1"/>
          <geom type="capsule" size="0.02 0.05"/>
          <body name="left_finger" pos="0 0 0.1">
            <joint name="j3" type="slide" axis="0 0 1" range="0 0.02"/>
            <geom type="box" size="0.005 0.01 0.02"/>
          </body>
          <body name="right_finger" pos="0 0 -0.1">
            <joint name="j4" type="slide" axis="0 0 1" range="0 0.02"/>
            <geom type="box" size="0.005 0.01 0.02"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <general name="a1" joint="j1" gainprm="10" biasprm="0 -10 -1"/>
    <general name="a2" joint="j2" gainprm="10" biasprm="0 -10 -1"/>
    <general name="a3" joint="j3" gainprm="10" biasprm="0 -10 -1"/>
    <general name="a4" joint="j4" gainprm="10" biasprm="0 -10 -1"/>
  </actuator>
</mujoco>
