<mujoco model="multi-free-bodies">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002"/>
  <default><joint damping="1" armature=".05"/><geom friction="1 .005 .0001"/></default>
  <worldbody>
    <geom name="table" type="box" size=".5 .5 .02" pos="0 0 -.02" rgba=".55 .55 .55 1"/>
    <body name="pallet" pos="-.12 0 .08">
      <freejoint name="pallet_free"/>
      <geom name="pallet_geom" type="box" size=".06 .06 .02" mass=".4" rgba=".85 .25 .1 1"/>
    </body>
    <body name="crate" pos=".08 0 .1">
      <freejoint name="crate_free"/>
      <geom name="crate_geom" type="box" size=".03 .03 .03" mass=".2" rgba=".1 .85 .2 1" group="3"/>
    </body>
    <body name="lever" pos=".3 0 .05">
      <joint name="lever_hinge" axis="0 0 1" range="-3 3"/>
      <geom name="lever_geom" type="capsule" fromto="0 0 0 .05 0 0" size=".01" mass=".05" rgba=".2 .4 .9 1"/>
    </body>
    <camera name="fixed" pos="0 -.9 .18" xyaxes="1 0 0 0 0 1" fovy="55"/>
  </worldbody>
  <actuator><position name="lever_motor" joint="lever_hinge" kp="40" kv="4"/></actuator>
</mujoco>
